
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/sesaes_db

# Clave secreta para firmar los JWT de sesión. DEBE ser larga, aleatoria,
# y distinta en cada ambiente (nunca reutilizar la de este ejemplo).
# Generarla con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# Minutos que dura la sesión antes de requerir login de nuevo (720 = 12 horas)
JWT_EXPIRE_MINUTES=720